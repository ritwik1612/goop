APP_ORIGIN=http://127.0.0.1:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a random string with at least 32 characters. Keep it server-side.
SESSION_SECRET=
# Opt in only after Google confirms nutrition.readonly is available to your project.
GOOGLE_NUTRITION_ENABLED=false

# Only this verified Google email can connect to your installation.
GOOP_OWNER_EMAIL=

GOOP_OWNER_NAME=
# Store a salted scrypt PIN hash on the server, never the plaintext PIN.
GOOP_PIN_HASH=
